# ─────────────────────────────────────────────────────────────
# Ghostty Config — macOS (Cobalt2 Theme)
# ─────────────────────────────────────────────────────────────
# Environment: bash 5.x + fzf + starship
# Philosophy: performance, clarity, and comfort
# ─────────────────────────────────────────────────────────────

# ---------- Fonts ----------
font-family = "JetBrains Mono"
font-size = 12.5
# Optional: disable ligatures if you prefer clarity
# font-feature = -calt,-liga,-dlig

grapheme-width-method = unicode

# ---------- Theme: Cobalt2 ----------
theme = "Cobalt2"

# ---------- Window & Layout ----------
window-decoration = true
window-theme = ghostty
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true
window-width  = 120
window-height = 34
window-show-tab-bar = auto

# ---------- Scrolling & Selection ----------
# limit: 256MB
scrollback-limit = 268435456
mouse-scroll-multiplier = 4
mouse-hide-while-typing = true
selection-clear-on-typing = true
selection-clear-on-copy   = false
copy-on-select = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-read  = ask
clipboard-write = allow

# ---------- Shell & Integration ----------
shell-integration = detect
shell-integration-features = cursor,sudo,title
window-inherit-working-directory = true
window-inherit-font-size = true
command = /opt/homebrew/bin/bash

# ---------- Notifications & Links ----------
link-previews = osc8
app-notifications = clipboard-copy,config-reload
desktop-notifications = true

# ---------- Quick Terminal ----------
quick-terminal-position = top
quick-terminal-size     = 35%

# ---------- Keybindings ----------
# Reload & fullscreen
keybind = super+r=reload_config
keybind = super+enter=toggle_fullscreen

# Tabs & splits
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+bracket_left=previous_tab
keybind = super+shift+bracket_right=next_tab
keybind = super+alt+right=goto_split:right
keybind = super+alt+left=goto_split:left
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down

# Clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Quick terminal toggle
keybind = super+Backquote=toggle_quick_terminal

# ---------- Safety & System ----------
async-backend = auto
term = xterm-ghostty
config-file = ?local.conf
